# ----------------------------------------------------------------------
# Generated by Premake: .slnx, .vcxproj, .vcxproj.filters,
# plus Visual Studio's .vcxproj.user and hidden .vs/ folder, which
# VS creates next to the solution (also inside build/)
# ----------------------------------------------------------------------
/build/

# ----------------------------------------------------------------------
# Build output: executables, libraries, .pdb, and Intermediates/
# (.obj, .ilk, .tlog), all produced by MSBuild/compiler/linker
# ----------------------------------------------------------------------
/Binaries/

# ----------------------------------------------------------------------
# Project files generated outside build/ (if Premake is ever run with a
# different location, or a solution is created by hand)
# ----------------------------------------------------------------------
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
ipch/
Makefile
*.make

# ----------------------------------------------------------------------
# Stray compiler/linker output (if anything is built outside Binaries/)
# Remove the library lines if you ever commit prebuilt libraries
# ----------------------------------------------------------------------
*.obj
*.o
*.pch
*.ilk
*.idb
*.pdb
*.exp
*.tlog
*.lastbuildstate
*.exe
*.out
*.app
*.lib
*.a
*.dll
*.so
*.dylib

# ----------------------------------------------------------------------
# Debugging and runtime leftovers
# ----------------------------------------------------------------------
*.dmp
*.log

# ----------------------------------------------------------------------
# Premake executable, if dropped into the repo instead of PATH
# ----------------------------------------------------------------------
premake5
premake5.exe

# ----------------------------------------------------------------------
# Xcode (macOS support is on the roadmap)
# ----------------------------------------------------------------------
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/

# ----------------------------------------------------------------------
# Operating system clutter
# ----------------------------------------------------------------------
# macOS Finder metadata
.DS_Store
# Windows Explorer thumbnail cache
Thumbs.db
._*
.AppleDouble
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory

# ----------------------------------------------------------------------
# Personal editor/IDE state
# Remove the .vscode/ line if you later want to share VS Code settings
# (tasks, launch configs) with everyone who clones the repo
# ----------------------------------------------------------------------
.vscode/
# JetBrains Rider/CLion
.idea/
.vs/
cmake-build-*/
.cache/
compile_commands.json
*.swp
*.swo